<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnHello" Content="HELLO" HorizontalAlignment="Left" Margin="36,50,0,0" VerticalAlignment="Top" Height="60" Width="183" FontSize="36" Background="#FF85BED6" Foreground="Red" Click="btnHello_Click"/>
        <TextBlock x:Name="txbInfo" HorizontalAlignment="Stretch" Margin="0,138,0,0" TextWrapping="Wrap" Text="TextBlock" FontSize="36" VerticalAlignment="Stretch"/>
    </Grid>
</Window>
